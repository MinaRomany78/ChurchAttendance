@model IEnumerable<ChurchAttendance.Models.Student>
@{
    ViewData["Title"] = "أعياد الميلاد الشهرية";
    int selectedMonth = ViewBag.SelectedMonth;
    int? selectedGroupId = ViewBag.SelectedGroupId;
    var groups = ViewBag.Groups as IEnumerable<ChurchAttendance.Models.StudentGroup>;

    string GetMonthName(int m) => new DateTime(2026, m, 1).ToString("MMMM", new System.Globalization.CultureInfo("ar-EG"));
}

<div class="d-flex justify-content-between align-items-center mb-4">
    <h2><i class="bi bi-cake2 text-warning me-2"></i>أعياد ميلاد شهر @GetMonthName(selectedMonth)</h2>

    <div class="btn-group" role="group">
        <a asp-action="Index" asp-route-month="@(selectedMonth == 1 ? 12 : selectedMonth - 1)" class="btn btn-outline-primary">
            <i class="bi bi-chevron-right"></i> الشهر السابق
        </a>
        <a asp-action="Index" asp-route-month="@DateTime.Today.Month" class="btn btn-primary">
            الشهر الحالي
        </a>
        <a asp-action="Index" asp-route-month="@(selectedMonth == 12 ? 1 : selectedMonth + 1)" class="btn btn-outline-primary">
            الشهر التالي <i class="bi bi-chevron-left"></i>
        </a>
    </div>
</div>

<div class="card mb-4 shadow-sm">
    <div class="card-body">
        <form method="get" class="row g-3">
            <div class="col-md-5">
                <label class="form-label">اختر الشهر</label>
                <select name="month" class="form-select" onchange="this.form.submit()">
                    @for (int i = 1; i <= 12; i++)
                    {
                        <!option value="@i" @(i == selectedMonth ? "selected" : "")>@GetMonthName(i)</!option>
                    }
                </select>
            </div>
            <div class="col-md-5">
                <label class="form-label">تصفية بالمجموعة</label>
                <select name="groupId" class="form-select" onchange="this.form.submit()">
                    <option value="">جميع المجموعات</option>
                    @if (groups != null)
                    {
                        foreach (var g in groups)
                        {
                            <!option value="@g.Id" @(g.Id == selectedGroupId ? "selected" : "")>@g.Name</!option>
                        }
                    }
                </select>
            </div>
            <div class="col-md-2 d-flex align-items-end">
                <a asp-action="Index" class="btn btn-secondary w-100">إعادة ضبط</a>
            </div>
        </form>
    </div>
</div>

@if (!Model.Any())
{
    <div class="alert alert-info text-center py-4">
        لا توجد أعياد ميلاد مسجلة في هذا الشهر للمرحلة المحددة.
    </div>
}
else
{
    var today = DateOnly.FromDateTime(DateTime.Today);

    <div class="row row-cols-1 row-cols-md-3 row-cols-lg-4 g-4">
        @foreach (var student in Model)
        {
            var dob = student.DateOfBirth!.Value;
            var age = today.Year - dob.Year - (today < dob.AddYears(today.Year - dob.Year) ? 1 : 0);

            <div class="col">
                <div class="card h-100 text-center shadow-sm border-0">
                    <div class="card-body">
                        <img src="@(string.IsNullOrEmpty(student.ProfileImagePath) ? "/images/default-avatar.png" : student.ProfileImagePath)"
                             class="rounded-circle mb-3 object-fit-cover"
                             style="width: 90px; height: 90px; border: 3px solid #0d6efd;"
                             alt="@student.FullName" />

                        <h5 class="card-title text-truncate">@student.FullName</h5>
                        <p class="text-muted small mb-2">كود: @student.StudentCode</p>

                        <div class="badge bg-light text-dark border mb-2">
                            @(student.Group?.Name ?? "بدون مجموعة")
                        </div>

                        <div class="p-2 bg-warning-subtle text-warning-emphasis rounded">
                            <i class="bi bi-balloon me-1"></i>
                            <strong>@dob.ToString("dd MMMM")</strong> (العمر: @age سنة)
                        </div>
                    </div>
                </div>
            </div>
        }
    </div>
}