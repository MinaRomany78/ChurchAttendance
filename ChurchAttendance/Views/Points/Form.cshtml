@model PointFormViewModel
@{
    ViewData["Title"] = Model.IsDeduction ? "خصم نقاط" : "إضافة نقاط";
}

<section class="panel form-panel">
    <form method="post" asp-action="@(Model.IsDeduction ? "Deduct" : "Award")">
        <div asp-validation-summary="ModelOnly" class="alert alert-danger" role="alert"></div>

        <div class="row g-3">
            <div class="col-12">
                <label class="form-label">الطالب</label>
                <partial name="_StudentPicker" model="new StudentPickerModel { StudentId = Model.StudentId, Label = Model.StudentLabel, Balance = Model.StudentBalance }" />
                <span asp-validation-for="StudentId" class="text-danger small"></span>
            </div>

            <div class="col-md-8">
                <label asp-for="PointReasonId" class="form-label"></label>
                <select asp-for="PointReasonId" class="form-select">
                    <option value="">اختر السبب</option>
                    @foreach (var r in Model.Reasons)
                    {
                        <option value="@r.Id" data-points="@r.DefaultPoints">@r.Name</option>
                    }
                </select>
                <span asp-validation-for="PointReasonId" class="text-danger small"></span>
                @if (Model.Reasons.Count == 0)
                {
                    <div class="form-text text-danger">لا توجد أسباب مفعّلة لهذا النوع. يمكن لمدير النظام إضافتها من صفحة «أسباب النقاط».</div>
                }
            </div>
            <div class="col-md-4">
                <label asp-for="Points" class="form-label"></label>
                <input asp-for="Points" type="number" min="1" max="10000" class="form-control" />
                <span asp-validation-for="Points" class="text-danger small"></span>
            </div>

            <div class="col-12">
                <label asp-for="Notes" class="form-label"></label>
                <textarea asp-for="Notes" class="form-control" rows="2"></textarea>
                <span asp-validation-for="Notes" class="text-danger small"></span>
            </div>

            @if (Model.IsDeduction)
            {
                <div class="col-12">
                    <div class="alert alert-warning mb-2">سيتم خصم النقاط من رصيد الطالب وتسجيل العملية باسمك في سجل المراجعة.</div>
                    <div class="form-check">
                        <input asp-for="ConfirmDeduction" class="form-check-input" />
                        <label asp-for="ConfirmDeduction" class="form-check-label"></label>
                    </div>
                </div>
            }
        </div>

        <div class="d-flex gap-2 mt-4">
            <button type="submit" class="btn @(Model.IsDeduction ? "btn-danger" : "btn-primary") px-4">@(Model.IsDeduction ? "خصم النقاط" : "إضافة النقاط")</button>
            <a asp-action="Index" class="btn btn-outline-secondary">إلغاء</a>
        </div>
    </form>
</section>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
    <script src="~/js/student-picker.js" asp-append-version="true"></script>
    <script src="~/js/points-form.js" asp-append-version="true"></script>
}
