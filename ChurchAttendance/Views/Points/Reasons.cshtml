@model List<PointReasonListItem>
@{
    ViewData["Title"] = "أسباب النقاط";
}

<div class="d-flex flex-wrap justify-content-between align-items-center gap-2 mb-3">
    <p class="text-muted mb-0">الأسباب التي تظهر عند إضافة النقاط أو خصمها.</p>
    <a asp-action="ReasonCreate" class="btn btn-primary"><i class="bi bi-plus-lg me-1"></i>إضافة سبب</a>
</div>

<section class="panel">
    @if (Model.Count == 0)
    {
        <div class="empty-state"><i class="bi bi-list-check"></i><p class="text-muted mb-0">لا توجد أسباب بعد.</p></div>
    }
    else
    {
        <div class="table-responsive">
            <table class="table align-middle mb-0">
                <thead><tr><th>السبب</th><th>النوع</th><th>النقاط الافتراضية</th><th>الحالة</th><th>الإجراءات</th></tr></thead>
                <tbody>
                @foreach (var r in Model)
                {
                    <tr>
                        <td class="fw-semibold">@r.Name</td>
                        <td><span class="badge-soft @(r.IsDeduction ? "badge-soft-danger" : "badge-soft-success")">@(r.IsDeduction ? "خصم" : "إضافة")</span></td>
                        <td>@r.DefaultPoints</td>
                        <td><span class="badge-soft @(r.IsActive ? "badge-soft-success" : "badge-soft-danger")">@(r.IsActive ? "مفعّل" : "موقوف")</span></td>
                        <td class="text-nowrap">
                            <a asp-action="ReasonEdit" asp-route-id="@r.Id" class="btn btn-sm btn-outline-primary">تعديل</a>
                            <form asp-action="ReasonToggle" method="post" class="d-inline" data-confirm="@(r.IsActive ? "إيقاف هذا السبب؟" : "تفعيل هذا السبب؟")">
                                <input type="hidden" name="id" value="@r.Id" />
                                <input type="hidden" name="active" value="@((!r.IsActive).ToString().ToLowerInvariant())" />
                                <button type="submit" class="btn btn-sm @(r.IsActive ? "btn-outline-danger" : "btn-outline-success")">@(r.IsActive ? "إيقاف" : "تفعيل")</button>
                            </form>
                        </td>
                    </tr>
                }
                </tbody>
            </table>
        </div>
    }
</section>
