@model PointReasonFormViewModel
@{
    ViewData["Title"] = Model.Id is null ? "إضافة سبب" : "تعديل سبب";
}

<section class="panel form-panel">
    <form asp-action="ReasonSave" method="post">
        <div asp-validation-summary="ModelOnly" class="alert alert-danger" role="alert"></div>
        <input type="hidden" asp-for="Id" />

        <div class="row g-3">
            <div class="col-md-8">
                <label asp-for="Name" class="form-label"></label>
                <input asp-for="Name" class="form-control" autofocus />
                <span asp-validation-for="Name" class="text-danger small"></span>
            </div>
            <div class="col-md-4">
                <label asp-for="DefaultPoints" class="form-label"></label>
                <input asp-for="DefaultPoints" type="number" min="1" max="10000" class="form-control" />
                <span asp-validation-for="DefaultPoints" class="text-danger small"></span>
            </div>
            <div class="col-12">
                <div class="form-check">
                    <input asp-for="IsDeduction" class="form-check-input" />
                    <label asp-for="IsDeduction" class="form-check-label"></label>
                </div>
            </div>
        </div>

        <div class="d-flex gap-2 mt-4">
            <button type="submit" class="btn btn-primary px-4">حفظ</button>
            <a asp-action="Reasons" class="btn btn-outline-secondary">إلغاء</a>
        </div>
    </form>
</section>

@section Scripts { <partial name="_ValidationScriptsPartial" /> }
