@model PointIndexViewModel
@{
    ViewData["Title"] = "سجل النقاط";
    var q = Model.Query;
    var r = Model.Result;

    string PageUrl(int p) => Url.Action("Index", new
    {
        q.Search, q.StudentId, Type = q.Type?.ToString(),
        From = q.From?.ToString("yyyy-MM-dd"), To = q.To?.ToString("yyyy-MM-dd"), page = p
    })!;

    var firstPage = Math.Max(1, r.Page - 2);
    var lastPage = Math.Min(r.TotalPages, r.Page + 2);
}

<section class="panel mb-3">
    <form method="get" asp-action="Index" class="row g-2 p-3 align-items-end">
        <input type="hidden" name="studentId" value="@q.StudentId" />

        <div class="col-12 col-lg-3">
            <label class="form-label small text-muted mb-1" for="search">اسم الطالب أو كوده</label>
            <input id="search" name="search" value="@q.Search" class="form-control" />
        </div>
        <div class="col-6 col-lg-2">
            <label class="form-label small text-muted mb-1" for="type">نوع الحركة</label>
            <select id="type" name="type" class="form-select">
                <option value="">الكل</option>
                @foreach (var t in Enum.GetValues<PointTransactionType>())
                {
                    <option value="@t" selected="@(q.Type == t)">@ArabicText.TransactionTypeText(t)</option>
                }
            </select>
        </div>
        <div class="col-6 col-lg-2">
            <label class="form-label small text-muted mb-1" for="from">من تاريخ</label>
            <input id="from" name="from" type="date" class="form-control" value="@(q.From?.ToString("yyyy-MM-dd"))" />
        </div>
        <div class="col-6 col-lg-2">
            <label class="form-label small text-muted mb-1" for="to">إلى تاريخ</label>
            <input id="to" name="to" type="date" class="form-control" value="@(q.To?.ToString("yyyy-MM-dd"))" />
        </div>
        <div class="col-6 col-lg-3 d-flex gap-2">
            <button type="submit" class="btn btn-primary flex-grow-1"><i class="bi bi-search me-1"></i>عرض</button>
            <a asp-action="Index" class="btn btn-outline-secondary" title="مسح الفلاتر" aria-label="مسح الفلاتر"><i class="bi bi-x-lg"></i></a>
        </div>
    </form>
</section>

@if (q.StudentId is not null)
{
    <div class="alert alert-info py-2 d-flex justify-content-between align-items-center">
        <span>يتم عرض حركات طالب محدد فقط.</span>
        <a asp-action="Index" class="btn btn-sm btn-outline-primary">عرض كل الطلاب</a>
    </div>
}

<div class="row g-3 mb-3">
    <div class="col-6 col-md-3"><div class="mini-stat"><span class="mini-value">@r.TotalCount.ToString("N0")</span><span class="mini-label">عدد الحركات</span></div></div>
    <div class="col-6 col-md-3"><div class="mini-stat"><span class="mini-value text-success">+@Model.TotalAdded.ToString("N0")</span><span class="mini-label">إجمالي المضاف</span></div></div>
    <div class="col-6 col-md-3"><div class="mini-stat"><span class="mini-value text-danger">-@Model.TotalDeducted.ToString("N0")</span><span class="mini-label">إجمالي المخصوم</span></div></div>
    <div class="col-6 col-md-3">
        @if (Model.CanManage)
        {
            <div class="d-grid gap-2 h-100">
                <a asp-action="Award" asp-route-studentId="@q.StudentId" class="btn btn-primary"><i class="bi bi-plus-circle me-1"></i>إضافة نقاط</a>
                <a asp-action="Deduct" asp-route-studentId="@q.StudentId" class="btn btn-outline-danger"><i class="bi bi-dash-circle me-1"></i>خصم نقاط</a>
            </div>
        }
    </div>
</div>

<section class="panel">
    @if (r.Items.Count == 0)
    {
        <div class="empty-state"><i class="bi bi-star"></i><p class="text-muted mb-0">لا توجد حركات نقاط مطابقة.</p></div>
    }
    else
    {
        <div class="table-responsive">
            <table class="table align-middle mb-0">
                <thead><tr><th>التاريخ</th><th>الطالب</th><th>النوع</th><th>النقاط</th><th>السبب</th><th>بواسطة</th><th>ملاحظات</th></tr></thead>
                <tbody>
                @foreach (var t in r.Items)
                {
                    <tr>
                        <td class="text-nowrap">@t.LocalDate.ToString("yyyy/MM/dd hh:mm tt")</td>
                        <td><a asp-controller="Students" asp-action="Details" asp-route-id="@t.StudentId" class="fw-semibold text-decoration-none">@t.StudentName</a><div class="small text-muted">@t.StudentCode</div></td>
                        <td>@ArabicText.TransactionTypeText(t.Type)</td>
                        <td><span dir="ltr" class="fw-bold @(t.Points > 0 ? "text-success" : "text-danger")">@(t.Points > 0 ? "+" : "")@t.Points</span></td>
                        <td>@t.Reason</td>
                        <td class="text-muted">@t.CreatedBy</td>
                        <td class="text-muted small">@t.Notes</td>
                    </tr>
                }
                </tbody>
            </table>
        </div>

        @if (r.TotalPages > 1)
        {
            <nav class="p-3 border-top" aria-label="التنقل بين الصفحات">
                <ul class="pagination justify-content-center mb-0">
                    <li class="page-item @(r.Page == 1 ? "disabled" : "")"><a class="page-link" href="@PageUrl(r.Page - 1)">السابق</a></li>
                    @for (var p = firstPage; p <= lastPage; p++)
                    {
                        <li class="page-item @(p == r.Page ? "active" : "")"><a class="page-link" href="@PageUrl(p)">@p</a></li>
                    }
                    <li class="page-item @(r.Page == r.TotalPages ? "disabled" : "")"><a class="page-link" href="@PageUrl(r.Page + 1)">التالي</a></li>
                </ul>
            </nav>
        }
    }
</section>
