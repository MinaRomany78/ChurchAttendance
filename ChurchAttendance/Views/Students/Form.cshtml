@model StudentFormViewModel
@{
    var isNew = Model.Id is null;
    ViewData["Title"] = isNew ? "إضافة طالب" : "تعديل بيانات الطالب";
}

<section class="panel form-panel">
    <form method="post" asp-action="@(isNew ? "Create" : "Edit")" asp-route-id="@Model.Id">
        <div asp-validation-summary="ModelOnly" class="alert alert-danger" role="alert"></div>

        <div class="row g-3">
            <div class="col-md-8">
                <label asp-for="FullName" class="form-label"></label>
                <input asp-for="FullName" class="form-control" autofocus />
                <span asp-validation-for="FullName" class="text-danger small"></span>
            </div>
            <div class="col-md-4">
                <label asp-for="StudentCode" class="form-label"></label>
                <input asp-for="StudentCode" class="form-control" placeholder="@(isNew ? "يُنشأ تلقائيًا إذا تُرك فارغًا" : "")" />
                <span asp-validation-for="StudentCode" class="text-danger small"></span>
            </div>

            <div class="col-md-4">
                <label asp-for="StageId" class="form-label"></label>
                <select asp-for="StageId" class="form-select">
                    <option value="">اختر المرحلة</option>
                    @foreach (var s in Model.Stages)
                    {
                        <option value="@s.Id">@s.Name</option>
                    }
                </select>
                <span asp-validation-for="StageId" class="text-danger small"></span>
            </div>
            <div class="col-md-4">
                <label asp-for="GroupId" class="form-label"></label>
                <select asp-for="GroupId" class="form-select" data-group-for="#StageId">
                    <option value="">بدون مجموعة</option>
                    @foreach (var g in Model.Groups)
                    {
                        <option value="@g.Id" data-stage="@g.StageId">@g.Name</option>
                    }
                </select>
                <span asp-validation-for="GroupId" class="text-danger small"></span>
            </div>
            <div class="col-md-4">
                <label asp-for="Gender" class="form-label"></label>
                <select asp-for="Gender" class="form-select">
                    <option value="">غير محدد</option>
                    <option value="@((int)Gender.Male)" selected="@(Model.Gender == Gender.Male)">ذكر</option>
                    <option value="@((int)Gender.Female)" selected="@(Model.Gender == Gender.Female)">أنثى</option>
                </select>
            </div>

            <div class="col-md-4">
                <label asp-for="DateOfBirth" class="form-label"></label>
                <input asp-for="DateOfBirth" type="date" class="form-control" />
                <span asp-validation-for="DateOfBirth" class="text-danger small"></span>
            </div>
            <div class="col-md-4">
                <label asp-for="Phone" class="form-label"></label>
                <input asp-for="Phone" class="form-control" inputmode="tel" dir="ltr" />
                <span asp-validation-for="Phone" class="text-danger small"></span>
            </div>
            <div class="col-md-4"></div>

            <div class="col-md-6">
                <label asp-for="GuardianName" class="form-label"></label>
                <input asp-for="GuardianName" class="form-control" />
                <span asp-validation-for="GuardianName" class="text-danger small"></span>
            </div>
            <div class="col-md-6">
                <label asp-for="GuardianPhone" class="form-label"></label>
                <input asp-for="GuardianPhone" class="form-control" inputmode="tel" dir="ltr" />
                <span asp-validation-for="GuardianPhone" class="text-danger small"></span>
            </div>

            <div class="col-12">
                <label asp-for="Address" class="form-label"></label>
                <input asp-for="Address" class="form-control" />
                <span asp-validation-for="Address" class="text-danger small"></span>
            </div>
        </div>

        <div class="d-flex gap-2 mt-4">
            <button type="submit" class="btn btn-primary px-4">حفظ</button>
            <a class="btn btn-outline-secondary" href="@(isNew ? Url.Action("Index") : Url.Action("Details", new { id = Model.Id }))">إلغاء</a>
        </div>
    </form>
</section>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
    <script src="~/js/stage-group.js" asp-append-version="true"></script>
}
