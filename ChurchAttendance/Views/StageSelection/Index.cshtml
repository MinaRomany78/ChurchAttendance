@model StageSelectionViewModel
@inject IChurchInfoService ChurchInfoService

@{
    ViewData["Title"] = "اختيار المرحلة الدراسية";
    Layout = null;
    var church = await ChurchInfoService.GetAsync();
}

<!DOCTYPE html>
<html lang="ar" dir="rtl">

<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - @church.Name</title>

    <!-- Bootstrap -->
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.rtl.min.css" />

    <!-- Bootstrap Icons -->
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css" />

    <!-- Cairo -->
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=Cairo:wght@400;500;600;700;800&display=swap" rel="stylesheet" />
</head>

<body>

    <div class="stage-page">

        <div class="stage-background"></div>
        <div class="stage-overlay"></div>

        <main class="stage-content">

            <!-- BRAND -->
            <div class="stage-brand">
                @if (!string.IsNullOrWhiteSpace(church.LogoPath))
                {
                    <div class="stage-brand-logo">
                        <img src="@church.LogoPath" alt="@church.Name" />
                    </div>
                }
                else
                {
                    <div class="stage-brand-cross">✝</div>
                }

                <h1>برنامج الحضور والمكافآت</h1>
                <p>@church.Name</p>
            </div>

            <!-- MAIN CARD -->
            <section class="stage-main-card">

                <div class="stage-main-header">
                    <div class="stage-main-icon">
                        <i class="bi bi-mortarboard-fill"></i>
                    </div>
                    <h2>اختر المرحلة الدراسية</h2>
                    <p>اختر المرحلة المناسبة للطلاب والحضور والنقاط</p>
                </div>

                @if (TempData["Error"] is string err)
                {
                    <div class="alert alert-danger stage-error">
                        <i class="bi bi-exclamation-circle-fill"></i>
                        <span>@err</span>
                    </div>
                }

                <!-- GROUPS -->
                <div class="stage-groups">

                    <!-- NURSERY -->
                    <div class="stage-group-card nursery">
                        <div class="stage-group-header">
                            <div class="stage-group-icon">
                                <i class="bi bi-balloon-fill"></i>
                            </div>
                            <div class="stage-group-title">
                                <h3>الحضانة</h3>
                                <p>مرحلة الروضة</p>
                            </div>
                            <span class="stage-count">2 مراحل</span>
                        </div>

                        <div class="stage-items">
                            @foreach (var s in Model.Stages.Where(x => x.Name.Contains("حضانة")).OrderBy(x => x.Id))
                            {
                                <form asp-action="Enter" method="post" class="stage-item-wrapper">
                                    <input type="hidden" name="stageId" value="@s.Id" />
                                    <input type="hidden" name="returnUrl" value="@Model.ReturnUrl" />

                                    <div class="stage-item">
                                        <div class="stage-item-number">
                                            @if (s.RequiresCode)
                                            {
                                                <i class="bi bi-lock-fill text-warning"></i>
                                            }
                                            else
                                            {
                                                @s.Id
                                            }
                                        </div>

                                        <div class="stage-name">
                                            @s.Name
                                        </div>

                                        @if (s.RequiresCode)
                                        {
                                            <button type="button" class="stage-enter-btn toggle-code-btn" data-target="box-@s.Id">
                                                رمز الدخول
                                                <i class="bi bi-chevron-down"></i>
                                            </button>
                                        }
                                        else
                                        {
                                            <button type="submit" class="stage-enter-btn">
                                                دخول
                                                <i class="bi bi-arrow-left"></i>
                                            </button>
                                        }
                                    </div>

                                    @if (s.RequiresCode)
                                    {
                                        <div class="stage-code-box d-none" id="box-@s.Id">
                                            <div class="stage-code-input">
                                                <input type="password" id="code-@s.Id" name="code" class="form-control" placeholder="أدخل رمز الدخول" autocomplete="off" inputmode="numeric" />
                                                <button type="button" class="stage-code-toggle" data-target="code-@s.Id">
                                                    <i class="bi bi-eye"></i>
                                                </button>
                                            </div>
                                            <button type="submit" class="stage-enter-btn stage-enter-secure mt-2">
                                                تأكيد الدخول
                                                <i class="bi bi-unlock-fill"></i>
                                            </button>
                                        </div>
                                    }
                                </form>
                            }
                        </div>
                    </div>

                    <!-- PRIMARY -->
                    <div class="stage-group-card primary">
                        <div class="stage-group-header">
                            <div class="stage-group-icon">
                                <i class="bi bi-book-fill"></i>
                            </div>
                            <div class="stage-group-title">
                                <h3>المرحلة الابتدائية</h3>
                                <p>الصف الأول حتى الصف السادس</p>
                            </div>
                            <span class="stage-count">6 مراحل</span>
                        </div>

                        <div class="stage-items">
                            @foreach (var s in Model.Stages.Where(x => x.Name.Contains("الابتدائي")).OrderBy(x => x.Id))
                            {
                                <form asp-action="Enter" method="post" class="stage-item-wrapper">
                                    <input type="hidden" name="stageId" value="@s.Id" />
                                    <input type="hidden" name="returnUrl" value="@Model.ReturnUrl" />

                                    <div class="stage-item">
                                        <div class="stage-item-number">
                                            @if (s.RequiresCode)
                                            {
                                                <i class="bi bi-lock-fill text-warning"></i>
                                            }
                                            else
                                            {
                                                @s.Id
                                            }
                                        </div>

                                        <div class="stage-name">
                                            @s.Name
                                        </div>

                                        @if (s.RequiresCode)
                                        {
                                            <button type="button" class="stage-enter-btn toggle-code-btn" data-target="box-@s.Id">
                                                رمز الدخول
                                                <i class="bi bi-chevron-down"></i>
                                            </button>
                                        }
                                        else
                                        {
                                            <button type="submit" class="stage-enter-btn">
                                                دخول
                                                <i class="bi bi-arrow-left"></i>
                                            </button>
                                        }
                                    </div>

                                    @if (s.RequiresCode)
                                    {
                                        <div class="stage-code-box d-none" id="box-@s.Id">
                                            <div class="stage-code-input">
                                                <input type="password" id="code-@s.Id" name="code" class="form-control" placeholder="أدخل رمز الدخول" autocomplete="off" inputmode="numeric" />
                                                <button type="button" class="stage-code-toggle" data-target="code-@s.Id">
                                                    <i class="bi bi-eye"></i>
                                                </button>
                                            </div>
                                            <button type="submit" class="stage-enter-btn stage-enter-secure mt-2">
                                                تأكيد الدخول
                                                <i class="bi bi-unlock-fill"></i>
                                            </button>
                                        </div>
                                    }
                                </form>
                            }
                        </div>
                    </div>

                    <!-- PREPARATORY -->
                    <div class="stage-group-card preparatory">
                        <div class="stage-group-header">
                            <div class="stage-group-icon">
                                <i class="bi bi-journal-bookmark-fill"></i>
                            </div>
                            <div class="stage-group-title">
                                <h3>المرحلة الإعدادية</h3>
                                <p>الصف الأول حتى الصف الثالث</p>
                            </div>
                            <span class="stage-count">3 مراحل</span>
                        </div>

                        <div class="stage-items">
                            @foreach (var s in Model.Stages.Where(x => x.Name.Contains("الإعدادي")).OrderBy(x => x.Id))
                            {
                                <form asp-action="Enter" method="post" class="stage-item-wrapper">
                                    <input type="hidden" name="stageId" value="@s.Id" />
                                    <input type="hidden" name="returnUrl" value="@Model.ReturnUrl" />

                                    <div class="stage-item">
                                        <div class="stage-item-number">
                                            @if (s.RequiresCode)
                                            {
                                                <i class="bi bi-lock-fill text-warning"></i>
                                            }
                                            else
                                            {
                                                @s.Id
                                            }
                                        </div>

                                        <div class="stage-name">
                                            @s.Name
                                        </div>

                                        @if (s.RequiresCode)
                                        {
                                            <button type="button" class="stage-enter-btn toggle-code-btn" data-target="box-@s.Id">
                                                رمز الدخول
                                                <i class="bi bi-chevron-down"></i>
                                            </button>
                                        }
                                        else
                                        {
                                            <button type="submit" class="stage-enter-btn">
                                                دخول
                                                <i class="bi bi-arrow-left"></i>
                                            </button>
                                        }
                                    </div>

                                    @if (s.RequiresCode)
                                    {
                                        <div class="stage-code-box d-none" id="box-@s.Id">
                                            <div class="stage-code-input">
                                                <input type="password" id="code-@s.Id" name="code" class="form-control" placeholder="أدخل رمز الدخول" autocomplete="off" inputmode="numeric" />
                                                <button type="button" class="stage-code-toggle" data-target="code-@s.Id">
                                                    <i class="bi bi-eye"></i>
                                                </button>
                                            </div>
                                            <button type="submit" class="stage-enter-btn stage-enter-secure mt-2">
                                                تأكيد الدخول
                                                <i class="bi bi-unlock-fill"></i>
                                            </button>
                                        </div>
                                    }
                                </form>
                            }
                        </div>
                    </div>

                    <!-- SECONDARY -->
                    <div class="stage-group-card secondary">
                        <div class="stage-group-header">
                            <div class="stage-group-icon">
                                <i class="bi bi-mortarboard-fill"></i>
                            </div>
                            <div class="stage-group-title">
                                <h3>المرحلة الثانوية</h3>
                                <p>الصف الأول حتى الصف الثالث</p>
                            </div>
                            <span class="stage-count">3 مراحل</span>
                        </div>

                        <div class="stage-items">
                            @foreach (var s in Model.Stages.Where(x => x.Name.Contains("الثانوي")).OrderBy(x => x.Id))
                            {
                                <form asp-action="Enter" method="post" class="stage-item-wrapper">
                                    <input type="hidden" name="stageId" value="@s.Id" />
                                    <input type="hidden" name="returnUrl" value="@Model.ReturnUrl" />

                                    <div class="stage-item">
                                        <div class="stage-item-number">
                                            @if (s.RequiresCode)
                                            {
                                                <i class="bi bi-lock-fill text-warning"></i>
                                            }
                                            else
                                            {
                                                @s.Id
                                            }
                                        </div>

                                        <div class="stage-name">
                                            @s.Name
                                        </div>

                                        @if (s.RequiresCode)
                                        {
                                            <button type="button" class="stage-enter-btn toggle-code-btn" data-target="box-@s.Id">
                                                رمز الدخول
                                                <i class="bi bi-chevron-down"></i>
                                            </button>
                                        }
                                        else
                                        {
                                            <button type="submit" class="stage-enter-btn">
                                                دخول
                                                <i class="bi bi-arrow-left"></i>
                                            </button>
                                        }
                                    </div>

                                    @if (s.RequiresCode)
                                    {
                                        <div class="stage-code-box d-none" id="box-@s.Id">
                                            <div class="stage-code-input">
                                                <input type="password" id="code-@s.Id" name="code" class="form-control" placeholder="أدخل رمز الدخول" autocomplete="off" inputmode="numeric" />
                                                <button type="button" class="stage-code-toggle" data-target="code-@s.Id">
                                                    <i class="bi bi-eye"></i>
                                                </button>
                                            </div>
                                            <button type="submit" class="stage-enter-btn stage-enter-secure mt-2">
                                                تأكيد الدخول
                                                <i class="bi bi-unlock-fill"></i>
                                            </button>
                                        </div>
                                    }
                                </form>
                            }
                        </div>
                    </div>

                </div>

            </section>

            <!-- VERSE -->
            <div class="stage-verse">
                <p>"ليكن كل شيء بترتيب ونظام"</p>
                <small>1 كورنثوس 14:40</small>
            </div>

        </main>

    </div>

    <!-- SCRIPT FOR TOGGLES -->
    <script>
            document.addEventListener("DOMContentLoaded", function() {
                // إظهار/إخفاء صندوق الكود عند الضغط على السهم/الزر للمرحلة
                document.querySelectorAll(".toggle-code-btn").forEach(btn => {
                    btn.addEventListener("click", function() {
                        const targetId = this.getAttribute("data-target");
                        const box = document.getElementById(targetId);
                        if (box) {
                            box.classList.toggle("d-none");
                            const icon = this.querySelector("i");
                            if (icon) {
                                icon.classList.toggle("bi-chevron-down");
                                icon.classList.toggle("bi-chevron-up");
                            }
                        }
                    });
                });

                // إظهار/إخفاء رمز كلمة السر
                document.querySelectorAll(".stage-code-toggle").forEach(btn => {
                    btn.addEventListener("click", function() {
                        const targetId = this.getAttribute("data-target");
                        const input = document.getElementById(targetId);
                        if (input) {
                            const icon = this.querySelector("i");
                            const isPassword = input.type === "password";
                            input.type = isPassword ? "text" : "password";
                            icon.classList.toggle("bi-eye", !isPassword);
                            icon.classList.toggle("bi-eye-slash", isPassword);
                        }
                    });
                });
            });
    </script>

    <style>
            * {
                box-sizing: border-box;
            }

            html, body {
                margin: 0;
                padding: 0;
                width: 100%;
                min-height: 100%;
                font-family: "Cairo", sans-serif;
            }

            .stage-page {
                min-height: 100vh;
                width: 100%;
                position: relative;
                overflow-x: hidden;
                background-image: url('/image/1.jpg');
                background-size: cover;
                background-position: center;
            }

            .stage-background {
                position: fixed;
                inset: 0;
                z-index: 0;
                background-image: url('/images/church-bg.jpg');
                background-size: cover;
                background-position: center;
            }

            .stage-overlay {
                position: fixed;
                inset: 0;
                z-index: 1;
                background: linear-gradient(135deg, rgba(8, 35, 67, .64), rgba(17, 58, 95, .46));
            }

            .stage-content {
                position: relative;
                z-index: 2;
                width: 100%;
                max-width: 1120px;
                margin: 0 auto;
                padding: 35px 25px 40px;
            }

            .stage-brand {
                text-align: center;
                color: #fff;
                margin-bottom: 22px;
            }

            .stage-brand-logo {
                width: 58px;
                height: 58px;
                margin: 0 auto 8px;
                border-radius: 50%;
                background: #fff;
                display: flex;
                align-items: center;
                justify-content: center;
                overflow: hidden;
                box-shadow: 0 8px 25px rgba(0,0,0,.25);
            }

                .stage-brand-logo img {
                    width: 100%;
                    height: 100%;
                    object-fit: contain;
                }

            .stage-brand-cross {
                color: #e0aa32;
                font-size: 3rem;
                margin-bottom: 6px;
            }

            .stage-brand h1 {
                margin: 0;
                font-size: 1.55rem;
                font-weight: 800;
            }

            .stage-brand p {
                margin: 2px 0 0;
                font-size: .85rem;
                color: rgba(255,255,255,.88);
            }

            .stage-main-card {
                width: 100%;
                background: rgba(255,255,255,.98);
                border-radius: 22px;
                padding: 32px;
                box-shadow: 0 25px 65px rgba(0,0,0,.28);
            }

            .stage-main-header {
                text-align: center;
                margin-bottom: 25px;
            }

            .stage-main-icon {
                width: 52px;
                height: 52px;
                margin: 0 auto 10px;
                border-radius: 50%;
                background: #123f78;
                color: #fff;
                display: flex;
                align-items: center;
                justify-content: center;
                font-size: 1.35rem;
            }

            .stage-main-header h2 {
                margin: 0;
                color: #142b4c;
                font-size: 1.5rem;
                font-weight: 800;
            }

            .stage-main-header p {
                margin: 5px 0 0;
                color: #7b8798;
                font-size: .82rem;
            }

            .stage-error {
                display: flex;
                align-items: center;
                gap: 8px;
                border-radius: 10px;
                margin-bottom: 20px;
                font-size: .8rem;
            }

            .stage-groups {
                display: grid;
                grid-template-columns: repeat(2, minmax(0, 1fr));
                gap: 18px;
            }

            .stage-group-card {
                position: relative;
                overflow: hidden;
                background: #fff;
                border: 1px solid #dce5ef;
                border-radius: 16px;
                box-shadow: 0 5px 18px rgba(22,53,90,.06);
            }

                .stage-group-card::before {
                    content: "";
                    position: absolute;
                    right: 0;
                    top: 0;
                    bottom: 0;
                    width: 4px;
                    background: #1680d8;
                }

            .stage-group-header {
                display: flex;
                align-items: center;
                gap: 12px;
                padding: 17px;
                background: #f8fafc;
                border-bottom: 1px solid #edf1f5;
            }

            .stage-group-icon {
                width: 46px;
                height: 46px;
                flex: 0 0 46px;
                border-radius: 12px;
                display: flex;
                align-items: center;
                justify-content: center;
                font-size: 1.15rem;
            }

            .stage-group-title {
                flex: 1;
                min-width: 0;
            }

                .stage-group-title h3 {
                    margin: 0;
                    color: #172b4d;
                    font-size: 1rem;
                    font-weight: 800;
                }

                .stage-group-title p {
                    margin: 2px 0 0;
                    color: #8a96a7;
                    font-size: .7rem;
                }

            .stage-count {
                padding: 5px 10px;
                border: 1px solid #dce5ef;
                background: #fff;
                color: #728096;
                border-radius: 20px;
                font-size: .65rem;
            }

            .stage-items {
                padding: 8px 12px 12px;
            }

            .stage-item-wrapper {
                border-bottom: 1px solid #f0f3f7;
                padding: 6px 0;
            }

                .stage-item-wrapper:last-child {
                    border-bottom: none;
                }

            .stage-item {
                display: flex;
                align-items: center;
                gap: 10px;
                min-height: 48px;
            }

            .stage-item-number {
                width: 34px;
                height: 34px;
                flex: 0 0 34px;
                display: flex;
                align-items: center;
                justify-content: center;
                border-radius: 10px;
                background: #edf3f9;
                color: #58708d;
                font-size: .72rem;
                font-weight: 700;
            }

            .stage-name {
                flex: 1;
                color: #172b4d;
                font-size: .82rem;
                font-weight: 700;
            }

            .stage-enter-btn {
                min-width: 88px;
                height: 38px;
                border: none;
                border-radius: 8px;
                background: #167bd2;
                color: #fff;
                font-family: inherit;
                font-size: .73rem;
                font-weight: 700;
                cursor: pointer;
                transition: .2s ease;
                display: inline-flex;
                align-items: center;
                justify-content: center;
                gap: 4px;
            }

                .stage-enter-btn:hover {
                    background: #1069b7;
                }

            /* Code Box */
            .stage-code-box {
                margin-top: 8px;
                padding: 10px;
                background: #f8fafc;
                border-radius: 8px;
                border: 1px dashed #cbd5e1;
            }

            .stage-code-input {
                position: relative;
            }

                .stage-code-input .form-control {
                    height: 38px;
                    border: 1px solid #d7e1ed;
                    border-radius: 6px;
                    padding: 0 10px 0 35px;
                    font-size: .78rem;
                    text-align: right;
                }

            .stage-code-toggle {
                position: absolute;
                left: 6px;
                top: 50%;
                transform: translateY(-50%);
                border: 0;
                background: transparent;
                color: #718096;
                cursor: pointer;
            }

            .stage-enter-secure {
                width: 100%;
                background: #12356b;
            }

                .stage-enter-secure:hover {
                    background: #0e2b57;
                }

            /* Theme colors */
            .nursery::before {
                background: #d39a18;
            }

            .nursery .stage-group-icon {
                background: #fff6dc;
                color: #c28a10;
            }

            .nursery .stage-enter-btn {
                background: #d39a18;
            }

                .nursery .stage-enter-btn:hover {
                    background: #b9810d;
                }

            .primary::before {
                background: #1680d8;
            }

            .primary .stage-group-icon {
                background: #e8f3fc;
                color: #1475c4;
            }

            .preparatory::before {
                background: #665dc4;
            }

            .preparatory .stage-group-icon {
                background: #efedff;
                color: #5b52b2;
            }

            .preparatory .stage-enter-btn {
                background: #665dc4;
            }

                .preparatory .stage-enter-btn:hover {
                    background: #5148aa;
                }

            .secondary::before {
                background: #29946e;
            }

            .secondary .stage-group-icon {
                background: #e8f8f1;
                color: #21825f;
            }

            .secondary .stage-enter-btn {
                background: #29946e;
            }

                .secondary .stage-enter-btn:hover {
                    background: #207957;
                }

            .stage-verse {
                text-align: center;
                color: #fff;
                margin-top: 20px;
            }

                .stage-verse p {
                    margin: 0 0 3px;
                    font-size: .9rem;
                    font-weight: 700;
                }

                .stage-verse small {
                    font-size: .72rem;
                    color: rgba(255,255,255,.85);
                }

            @@media (max-width: 850px) {
                .stage-content {
                    max-width: 720px;
                    padding: 28px 18px 35px;
                }

                .stage-main-card {
                    padding: 24px 18px;
                }

                .stage-groups {
                    grid-template-columns: 1fr;
                }
            }
    </style>

</body>
</html>