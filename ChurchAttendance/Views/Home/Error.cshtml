@model ErrorViewModel
@{
    ViewData["Title"] = Model.Title;
    Layout = "_AuthLayout";
}
<section class="auth-card text-center">
    <div class="display-4 fw-bold text-gold">@Model.Code</div>
    <h1 class="h4 fw-bold mt-2">@Model.Title</h1>
    <p class="text-muted">@Model.Message</p>
    <a href="/" class="btn btn-primary">العودة إلى الصفحة الرئيسية</a>
</section>
