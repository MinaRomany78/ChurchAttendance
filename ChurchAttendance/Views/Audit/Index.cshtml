@model AuditIndexViewModel
@{
    ViewData["Title"] = "سجل المراجعة";
    var q = Model.Query;
    var r = Model.Result;

    string PageUrl(int p) => Url.Action("Index", new
    {
        From = q.From?.ToString("yyyy-MM-dd"), To = q.To?.ToString("yyyy-MM-dd"),
        q.User, q.Entity, q.Action, page = p
    })!;

    var firstPage = Math.Max(1, r.Page - 2);
    var lastPage = Math.Min(r.TotalPages, r.Page + 2);
}

<section class="panel mb-3">
    <form method="get" asp-action="Index" class="row g-2 p-3 align-items-end">
        <div class="col-6 col-lg-2">
            <label class="form-label small text-muted mb-1" for="from">من تاريخ</label>
            <input id="from" name="from" type="date" class="form-control" value="@(q.From?.ToString("yyyy-MM-dd"))" />
        </div>
        <div class="col-6 col-lg-2">
            <label class="form-label small text-muted mb-1" for="to">إلى تاريخ</label>
            <input id="to" name="to" type="date" class="form-control" value="@(q.To?.ToString("yyyy-MM-dd"))" />
        </div>
        <div class="col-6 col-lg-2">
            <label class="form-label small text-muted mb-1" for="user">المستخدم</label>
            <input id="user" name="user" class="form-control" value="@q.User" />
        </div>
        <div class="col-6 col-lg-2">
            <label class="form-label small text-muted mb-1" for="entity">الكيان</label>
            <select id="entity" name="entity" class="form-select">
                <option value="">الكل</option>
                @foreach (var e in Model.Entities)
                {
                    <option value="@e" selected="@(q.Entity == e)">@e</option>
                }
            </select>
        </div>
        <div class="col-6 col-lg-2">
            <label class="form-label small text-muted mb-1" for="action">الإجراء (كود)</label>
            <input id="action" name="action" class="form-control" dir="ltr" value="@q.Action" placeholder="PointsAwarded" />
        </div>
        <div class="col-6 col-lg-2 d-flex gap-2">
            <button type="submit" class="btn btn-primary flex-grow-1"><i class="bi bi-search me-1"></i>عرض</button>
            <a asp-action="Index" class="btn btn-outline-secondary" title="مسح الفلاتر" aria-label="مسح الفلاتر"><i class="bi bi-x-lg"></i></a>
        </div>
    </form>
</section>

<div class="text-muted mb-3">عدد السجلات: @r.TotalCount.ToString("N0")</div>

<section class="panel">
    @if (r.Items.Count == 0)
    {
        <div class="empty-state"><i class="bi bi-shield-check"></i><p class="text-muted mb-0">لا توجد سجلات مطابقة.</p></div>
    }
    else
    {
        <div class="table-responsive">
            <table class="table align-middle mb-0">
                <thead><tr><th>الوقت</th><th>المستخدم</th><th>الإجراء</th><th>الكيان</th><th>التفاصيل</th></tr></thead>
                <tbody>
                @foreach (var a in r.Items)
                {
                    <tr>
                        <td class="text-nowrap">@a.LocalTime.ToString("yyyy/MM/dd hh:mm tt")</td>
                        <td dir="ltr" class="text-end small">@a.UserName</td>
                        <td>
                            <div class="fw-semibold">@a.ActionText</div>
                            <div class="small text-muted" dir="ltr">@a.Action</div>
                        </td>
                        <td>@a.Entity @if (a.EntityId is not null) { <span class="text-muted">#@a.EntityId</span> }</td>
                        <td>
                            @if (a.OldValues is not null || a.NewValues is not null || a.IpAddress is not null)
                            {
                                <details class="audit-details">
                                    <summary>عرض</summary>
                                    @if (a.OldValues is not null) { <div class="small"><strong>قبل:</strong> <code dir="ltr">@a.OldValues</code></div> }
                                    @if (a.NewValues is not null) { <div class="small"><strong>بعد:</strong> <code dir="ltr">@a.NewValues</code></div> }
                                    @if (a.IpAddress is not null) { <div class="small text-muted">IP: <span dir="ltr">@a.IpAddress</span></div> }
                                </details>
                            }
                        </td>
                    </tr>
                }
                </tbody>
            </table>
        </div>

        @if (r.TotalPages > 1)
        {
            <nav class="p-3 border-top" aria-label="التنقل بين الصفحات">
                <ul class="pagination justify-content-center mb-0">
                    <li class="page-item @(r.Page == 1 ? "disabled" : "")"><a class="page-link" href="@PageUrl(r.Page - 1)">السابق</a></li>
                    @for (var p = firstPage; p <= lastPage; p++)
                    {
                        <li class="page-item @(p == r.Page ? "active" : "")"><a class="page-link" href="@PageUrl(p)">@p</a></li>
                    }
                    <li class="page-item @(r.Page == r.TotalPages ? "disabled" : "")"><a class="page-link" href="@PageUrl(r.Page + 1)">التالي</a></li>
                </ul>
            </nav>
        }
    }
</section>
