@model UserFormViewModel
@{
    var isNew = Model.Id is null;
    ViewData["Title"] = isNew ? "إضافة مستخدم" : "تعديل مستخدم";
}

<section class="panel form-panel">
    <form method="post" asp-action="@(isNew ? "Create" : "Edit")" asp-route-id="@Model.Id" autocomplete="off">
        <div asp-validation-summary="ModelOnly" class="alert alert-danger" role="alert"></div>

        <div class="row g-3">
            <div class="col-md-6">
                <label asp-for="FullName" class="form-label"></label>
                <input asp-for="FullName" class="form-control" autofocus />
                <span asp-validation-for="FullName" class="text-danger small"></span>
            </div>
            <div class="col-md-6">
                <label asp-for="Email" class="form-label"></label>
                <input asp-for="Email" type="email" dir="ltr" class="form-control" autocomplete="off" />
                <span asp-validation-for="Email" class="text-danger small"></span>
            </div>

            <div class="col-md-6">
                <label asp-for="Role" class="form-label"></label>
                @if (Model.IsCurrentUser)
                {
                    <input type="hidden" asp-for="Role" />
                    <input class="form-control" value="@AppRoles.DisplayName(Model.Role)" disabled />
                    <div class="form-text">لا يمكنك تغيير دورك بنفسك.</div>
                }
                else
                {
                    <select asp-for="Role" class="form-select">
                        <option value="">اختر الدور</option>
                        @foreach (var role in AppRoles.All)
                        {
                            <option value="@role">@AppRoles.DisplayName(role)</option>
                        }
                    </select>
                    <span asp-validation-for="Role" class="text-danger small"></span>
                }
            </div>

            <div class="col-md-6 d-flex align-items-end">
                @if (Model.IsCurrentUser)
                {
                    <input type="hidden" name="IsActive" value="true" />
                    <div class="text-muted small">لا يمكنك إيقاف حسابك بنفسك.</div>
                }
                else
                {
                    <div class="form-check">
                        <input asp-for="IsActive" class="form-check-input" />
                        <label asp-for="IsActive" class="form-check-label"></label>
                    </div>
                }
            </div>

            @if (isNew)
            {
                <div class="col-md-6">
                    <label asp-for="Password" class="form-label"></label>
                    <input asp-for="Password" class="form-control" autocomplete="new-password" />
                    <span asp-validation-for="Password" class="text-danger small"></span>
                    <div class="form-text">8 أحرف على الأقل وتحتوي على حرف إنجليزي صغير ورقم.</div>
                </div>
                <div class="col-md-6">
                    <label asp-for="ConfirmPassword" class="form-label"></label>
                    <input asp-for="ConfirmPassword" class="form-control" autocomplete="new-password" />
                    <span asp-validation-for="ConfirmPassword" class="text-danger small"></span>
                </div>
            }
        </div>

        <div class="d-flex gap-2 mt-4">
            <button type="submit" class="btn btn-primary px-4">حفظ</button>
            <a asp-action="Index" class="btn btn-outline-secondary">إلغاء</a>
        </div>
    </form>
</section>

@section Scripts { <partial name="_ValidationScriptsPartial" /> }
