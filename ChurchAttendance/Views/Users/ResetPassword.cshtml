@model ResetPasswordViewModel
@{
    ViewData["Title"] = "إعادة تعيين كلمة المرور";
}

<section class="panel form-panel">
    <p class="text-muted">تعيين كلمة مرور جديدة للمستخدم <strong class="text-body">@Model.DisplayName</strong>. سيتم فك أي قفل مؤقت على حسابه.</p>

    <form asp-action="ResetPassword" method="post" autocomplete="off">
        <div asp-validation-summary="ModelOnly" class="alert alert-danger" role="alert"></div>
        <input type="hidden" asp-for="Id" />

        <div class="row g-3">
            <div class="col-md-6">
                <label asp-for="NewPassword" class="form-label"></label>
                <input asp-for="NewPassword" class="form-control" autocomplete="new-password" autofocus />
                <span asp-validation-for="NewPassword" class="text-danger small"></span>
            </div>
            <div class="col-md-6">
                <label asp-for="ConfirmPassword" class="form-label"></label>
                <input asp-for="ConfirmPassword" class="form-control" autocomplete="new-password" />
                <span asp-validation-for="ConfirmPassword" class="text-danger small"></span>
            </div>
        </div>

        <div class="d-flex gap-2 mt-4">
            <button type="submit" class="btn btn-primary px-4">تعيين كلمة المرور</button>
            <a asp-action="Index" class="btn btn-outline-secondary">إلغاء</a>
        </div>
    </form>
</section>

@section Scripts { <partial name="_ValidationScriptsPartial" /> }
