@model RedemptionIndexViewModel
@{
    ViewData["Title"] = "الاستبدالات";
    var q = Model.Query;
    var r = Model.Result;

    string PageUrl(int p) => Url.Action("Redemptions", new
    {
        q.Search, Status = q.Status?.ToString(),
        From = q.From?.ToString("yyyy-MM-dd"), To = q.To?.ToString("yyyy-MM-dd"), page = p
    })!;

    var firstPage = Math.Max(1, r.Page - 2);
    var lastPage = Math.Min(r.TotalPages, r.Page + 2);
}

<section class="panel mb-3">
    <form method="get" asp-action="Redemptions" class="row g-2 p-3 align-items-end">
        <div class="col-12 col-lg-3">
            <label class="form-label small text-muted mb-1" for="search">طالب أو مكافأة</label>
            <input id="search" name="search" value="@q.Search" class="form-control" />
        </div>
        <div class="col-6 col-lg-2">
            <label class="form-label small text-muted mb-1" for="status">الحالة</label>
            <select id="status" name="status" class="form-select">
                <option value="">الكل</option>
                @foreach (var s in Enum.GetValues<RedemptionStatus>())
                {
                    <option value="@s" selected="@(q.Status == s)">@ArabicText.RedemptionStatusText(s)</option>
                }
            </select>
        </div>
        <div class="col-6 col-lg-2">
            <label class="form-label small text-muted mb-1" for="from">من تاريخ</label>
            <input id="from" name="from" type="date" class="form-control" value="@(q.From?.ToString("yyyy-MM-dd"))" />
        </div>
        <div class="col-6 col-lg-2">
            <label class="form-label small text-muted mb-1" for="to">إلى تاريخ</label>
            <input id="to" name="to" type="date" class="form-control" value="@(q.To?.ToString("yyyy-MM-dd"))" />
        </div>
        <div class="col-6 col-lg-3 d-flex gap-2">
            <button type="submit" class="btn btn-primary flex-grow-1"><i class="bi bi-search me-1"></i>عرض</button>
            <a asp-action="Redemptions" class="btn btn-outline-secondary" title="مسح الفلاتر" aria-label="مسح الفلاتر"><i class="bi bi-x-lg"></i></a>
        </div>
    </form>
</section>

<div class="d-flex justify-content-between align-items-center mb-3">
    <span class="text-muted">عدد الاستبدالات: @r.TotalCount.ToString("N0")</span>
    @if (Model.CanManage)
    {
        <a asp-action="Redeem" class="btn btn-primary"><i class="bi bi-gift me-1"></i>استبدال مكافأة</a>
    }
</div>

<section class="panel">
    @if (r.Items.Count == 0)
    {
        <div class="empty-state"><i class="bi bi-gift"></i><p class="text-muted mb-0">لا توجد استبدالات مطابقة.</p></div>
    }
    else
    {
        <div class="table-responsive">
            <table class="table align-middle mb-0">
                <thead>
                <tr><th>التاريخ</th><th>الطالب</th><th>المكافأة</th><th>النقاط</th><th>الحالة</th><th>ملاحظات</th>@if (Model.CanManage) { <th>الإجراءات</th> }</tr>
                </thead>
                <tbody>
                @foreach (var x in r.Items)
                {
                    <tr>
                        <td class="text-nowrap">@x.LocalDate.ToString("yyyy/MM/dd hh:mm tt")</td>
                        <td><a asp-controller="Students" asp-action="Details" asp-route-id="@x.StudentId" class="fw-semibold text-decoration-none">@x.StudentName</a><div class="small text-muted">@x.StudentCode</div></td>
                        <td>@x.RewardName</td>
                        <td>@x.PointsUsed.ToString("N0")</td>
                        <td><span class="badge-soft @ArabicText.RedemptionBadge(x.Status)">@ArabicText.RedemptionStatusText(x.Status)</span></td>
                        <td class="text-muted small">@x.Notes</td>
                        @if (Model.CanManage)
                        {
                            <td class="text-nowrap">
                                @if (x.Status == RedemptionStatus.Pending)
                                {
                                    <form asp-action="Approve" method="post" class="d-inline"><input type="hidden" name="id" value="@x.Id" /><button type="submit" class="btn btn-sm btn-outline-primary">موافقة</button></form>
                                }
                                @if (x.Status is RedemptionStatus.Pending or RedemptionStatus.Approved)
                                {
                                    <form asp-action="Deliver" method="post" class="d-inline" data-confirm="تأكيد تسليم المكافأة للطالب؟"><input type="hidden" name="id" value="@x.Id" /><button type="submit" class="btn btn-sm btn-outline-success">تسليم</button></form>
                                    <form asp-action="Cancel" method="post" class="d-inline" data-confirm="إلغاء الاستبدال وإرجاع @x.PointsUsed نقطة للطالب؟"><input type="hidden" name="id" value="@x.Id" /><button type="submit" class="btn btn-sm btn-outline-danger">إلغاء</button></form>
                                }
                            </td>
                        }
                    </tr>
                }
                </tbody>
            </table>
        </div>

        @if (r.TotalPages > 1)
        {
            <nav class="p-3 border-top" aria-label="التنقل بين الصفحات">
                <ul class="pagination justify-content-center mb-0">
                    <li class="page-item @(r.Page == 1 ? "disabled" : "")"><a class="page-link" href="@PageUrl(r.Page - 1)">السابق</a></li>
                    @for (var p = firstPage; p <= lastPage; p++)
                    {
                        <li class="page-item @(p == r.Page ? "active" : "")"><a class="page-link" href="@PageUrl(p)">@p</a></li>
                    }
                    <li class="page-item @(r.Page == r.TotalPages ? "disabled" : "")"><a class="page-link" href="@PageUrl(r.Page + 1)">التالي</a></li>
                </ul>
            </nav>
        }
    }
</section>
