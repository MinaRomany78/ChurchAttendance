@model List<StageListItem>
@{
    ViewData["Title"] = "المراحل";
}

<div class="d-flex flex-wrap justify-content-between align-items-center gap-2 mb-3">
    <p class="text-muted mb-0">المراحل الدراسية التي ينتمي إليها الطلاب. لا يمكن إيقاف مرحلة بها طلاب نشطون.</p>
    <a asp-action="Create" class="btn btn-primary"><i class="bi bi-plus-lg me-1"></i>إضافة مرحلة</a>
</div>

<section class="panel">
    @if (Model.Count == 0)
    {
        <div class="empty-state">
            <i class="bi bi-diagram-3"></i>
            <p class="text-muted">لم تُضف أي مرحلة بعد. ابدأ بإضافة المرحلة الأولى.</p>
            <a asp-action="Create" class="btn btn-primary">إضافة مرحلة</a>
        </div>
    }
    else
    {
        <div class="table-responsive">
            <table class="table align-middle mb-0">
                <thead>
                <tr><th>الترتيب</th><th>المرحلة</th><th>الوصف</th><th>المجموعات</th><th>الطلاب النشطون</th><th>رمز الدخول</th><th>الحالة</th><th>الإجراءات</th></tr>
                </thead>
                <tbody>
                @foreach (var s in Model)
                {
                    <tr>
                        <td>@s.SortOrder</td>
                        <td class="fw-semibold">@s.Name</td>
                        <td class="text-muted">@s.Description</td>
                        <td><a asp-controller="Groups" asp-action="Index" asp-route-stageId="@s.Id">@s.GroupCount</a></td>
                        <td>@s.StudentCount</td>
                        <td>
                            @if (s.RequiresCode)
                            {
                                <span class="badge-soft badge-soft-gold"><i class="bi bi-lock-fill"></i> مفعّل</span>
                            }
                            else
                            {
                                <span class="badge-soft badge-soft-info">بلا رمز</span>
                            }
                        </td>
                        <td>
                            <span class="badge-soft @(s.IsActive ? "badge-soft-success" : "badge-soft-danger")">@(s.IsActive ? "نشطة" : "موقوفة")</span>
                        </td>
                        <td class="text-nowrap">
                            <a asp-action="Edit" asp-route-id="@s.Id" class="btn btn-sm btn-outline-primary">تعديل</a>
                            <a asp-action="AccessCode" asp-route-id="@s.Id" class="btn btn-sm btn-outline-secondary">رمز الدخول</a>
                            <form asp-action="Toggle" method="post" class="d-inline"
                                  data-confirm="@(s.IsActive ? "هل تريد إيقاف هذه المرحلة؟" : "هل تريد تفعيل هذه المرحلة؟")">
                                <input type="hidden" name="id" value="@s.Id" />
                                <input type="hidden" name="active" value="@((!s.IsActive).ToString().ToLowerInvariant())" />
                                <button type="submit" class="btn btn-sm @(s.IsActive ? "btn-outline-danger" : "btn-outline-success")">@(s.IsActive ? "إيقاف" : "تفعيل")</button>
                            </form>
                        </td>
                    </tr>
                }
                </tbody>
            </table>
        </div>
    }
</section>
