@model ChangePasswordViewModel
@{
    ViewData["Title"] = "تغيير كلمة المرور";
}

<section class="panel form-panel">
    <form asp-action="ChangePassword" method="post" autocomplete="off">
        <div asp-validation-summary="ModelOnly" class="alert alert-danger" role="alert"></div>

        <div class="row g-3">
            <div class="col-md-6">
                <label asp-for="CurrentPassword" class="form-label"></label>
                <input asp-for="CurrentPassword" class="form-control" autocomplete="current-password" autofocus />
                <span asp-validation-for="CurrentPassword" class="text-danger small"></span>
            </div>
            <div class="col-12"></div>
            <div class="col-md-6">
                <label asp-for="NewPassword" class="form-label"></label>
                <input asp-for="NewPassword" class="form-control" autocomplete="new-password" />
                <span asp-validation-for="NewPassword" class="text-danger small"></span>
                <div class="form-text">8 أحرف على الأقل وتحتوي على حرف إنجليزي صغير ورقم.</div>
            </div>
            <div class="col-md-6">
                <label asp-for="ConfirmPassword" class="form-label"></label>
                <input asp-for="ConfirmPassword" class="form-control" autocomplete="new-password" />
                <span asp-validation-for="ConfirmPassword" class="text-danger small"></span>
            </div>
        </div>

        <div class="d-flex gap-2 mt-4">
            <button type="submit" class="btn btn-primary px-4">حفظ</button>
            <a asp-controller="Home" asp-action="Index" class="btn btn-outline-secondary">إلغاء</a>
        </div>
    </form>
</section>

@section Scripts { <partial name="_ValidationScriptsPartial" /> }
